{UTF-8}
********************************************************
	.instituciones
********************************************************~
		Adquisicion de instituciones: prospeccion, pilotos, clientes y churn.
	|

Instituciones potenciales= INTEG (
	pilotos no convertidos-inicio de pilotos-inicio de virtualizaciones gratis,
		instituciones en el mercado-clientes iniciales-pilotos iniciales)
	~	Institucion [0,?]
	~	Universidades e IES del mercado objetivo que aun no usan la plataforma.
	|

Instituciones en piloto= INTEG (
	inicio de pilotos+virtualizaciones que pasan al pipeline-conversion de pilotos-pilotos no convertidos,
		pilotos iniciales)
	~	Institucion [0,?]
	~	Instituciones probando la plataforma, normalmente desde una unidad \
		academica (educacion continua o innovacion).
	|

Instituciones cliente= INTEG (
	conversion de pilotos+compras al terminar la virtualizacion-churn de instituciones,
		clientes iniciales)
	~	Institucion [0,?]
	~	Instituciones con contrato activo (al menos una unidad academica \
		emitiendo).
	|

Instituciones perdidas= INTEG (
	churn de instituciones,
		0)
	~	Institucion [0,?]
	~	Instituciones que fueron clientes y se fueron (no vuelven al mercado en el \
		horizonte).
	|

inicio de pilotos=
	Instituciones potenciales*(fraccion de prospeccion+contagio institucional+atraccion del ecosistema)+propuestas de paid media sin cupo
	~	Institucion/Month
	~	Nuevos pilotos: prospeccion propia (outbound, eventos, marketing), boca a \
		boca entre instituciones (R1), atraccion porque la credencial ya es moneda \
		de movilidad (R6) y leads de la tactica de paid media.
	|

contagio institucional=
	activar boca a boca institucional*efectividad del boca a boca institucional*Instituciones cliente/instituciones en el mercado
	~	1/Month
	~	Fraccion mensual de potenciales que inician piloto por referencia de \
		clientes (Bass).
	|

atraccion del ecosistema=
	activar flywheel del ecosistema*atraccion maxima por valor de la credencial*Valor percibido de la credencial
	~	1/Month
	~	Fraccion mensual de potenciales que buscan la plataforma porque \
		estudiantes y empresas ya piden la credencial (bucle R6).
	|

conversion de pilotos=
	Instituciones en piloto/duracion del piloto*fraccion de conversion de pilotos
	~	Institucion/Month
	~	Pilotos que firman contrato.
	|

pilotos no convertidos=
	Instituciones en piloto/duracion del piloto*(1-fraccion de conversion de pilotos)
	~	Institucion/Month
	~	Pilotos que no convierten y vuelven al mercado potencial.
	|

churn de instituciones=
	Instituciones cliente*fraccion de churn institucional*(1-activar flywheel del ecosistema*reduccion maxima del churn por valor*Valor percibido de la credencial)
	~	Institucion/Month
	~	Instituciones que dejan la plataforma. Cuanto mas vale la credencial \
		(datos de competencias, empleabilidad, marketing), menos churn.
	|

instituciones en el mercado=
	600
	~	Institucion [100,3000,50]
	~	SUPUESTO: tamano del mercado objetivo. En HubSpot (17-oct-2026) ya hay 401 \
		instituciones educativas con actividad y 542 instituciones sin actividad.
	|

clientes iniciales=
	11
	~	Institucion [0,200,1]
	~	DATO HubSpot 17-oct-2026: instituciones con negocio en Ganado credenciales \
		POK (8 IES y cajas de compensacion, PMI Bogota, Connect Bogota y Team \
		Rush).
	|

pilotos iniciales=
	68
	~	Institucion [0,200,1]
	~	DATO HubSpot 17-oct-2026: instituciones que aun no son clientes con \
		negocio abierto en los pipelines POK entre propuesta enviada y sesion de \
		cierre (etapas 3 a 5).
	|

fraccion de prospeccion=
	0.027
	~	1/Month [0,0.06,0.001]
	~	DATO HubSpot / PALANCA: unas 15 instituciones por mes llegan a propuesta \
		POK entre abril y octubre de 2026, sobre 521 potenciales; 0.027 = 2.7 % al \
		mes.
	|

efectividad del boca a boca institucional=
	0.05
	~	1/Month [0,0.3,0.01]
	~	SUPUESTO: inicio de pilotos por mes y por potencial si todo el mercado \
		fuera cliente.
	|

atraccion maxima por valor de la credencial=
	0.02
	~	1/Month [0,0.05,0.001]
	~	SUPUESTO: fraccion mensual de potenciales que llega sola cuando la \
		credencial vale el maximo.
	|

duracion del piloto=
	9.8
	~	Month [1,24,0.5]
	~	DATO HubSpot 17-oct-2026: meses desde la propuesta hasta la decision. 76 \
		negocios POK en etapas 3 a 5 / 7.8 negocios que salen del pipeline por mes \
		(ley de Little).
	|

fraccion de conversion de pilotos=
	0.24
	~	Dmnl [0,1,0.01]
	~	DATO HubSpot / PALANCA: de 45 negocios POK que salieron del pipeline entre \
		abril y octubre de 2026, 11 se ganaron, 24 se perdieron y 10 quedaron para \
		retomar.
	|

fraccion de churn institucional=
	0.01
	~	1/Month [0,0.05,0.001]
	~	SUPUESTO: churn mensual de instituciones sin efecto del valor (0.01 ~ 11 % \
		al ano).
	|

reduccion maxima del churn por valor=
	0.6
	~	Dmnl [0,1,0.05]
	~	SUPUESTO: cuanto se reduce el churn cuando la credencial vale el maximo.
	|

********************************************************
	.unidades academicas
********************************************************~
		Land and expand: cada institucion cliente entra por una unidad y se expande a otras.
	|

Unidades activas= INTEG (
	unidades por nuevos clientes+expansion interna-churn de unidades-unidades perdidas con instituciones,
		unidades iniciales)
	~	Unidad [0,?]
	~	Unidades academicas emitiendo credenciales (educacion continua, \
		innovacion, facultades...).
	|

unidades por nuevos clientes=
	(conversion de pilotos+compras al terminar la virtualizacion)*unidades de entrada por cliente
	~	Unidad/Month
	~	Cada nuevo cliente entra con su unidad de entrada.
	|

unidades sin activar en clientes=
	MAX(0,Instituciones cliente*unidades academicas por institucion-Unidades activas)
	~	Unidad
	~	Unidades de las instituciones cliente que todavia no emiten: el espacio de \
		expansion.
	|

penetracion interna=
	ZIDZ(Unidades activas,Instituciones cliente*unidades academicas por institucion)
	~	Dmnl
	~	Fraccion de las unidades de los clientes que ya emiten.
	|

expansion interna=
	unidades sin activar en clientes*(fraccion de expansion institucional+activar expansion interna*efectividad del contagio interno*penetracion interna)
	~	Unidad/Month
	~	Nuevas unidades dentro de clientes: por decision central \
		(vicerrectoria/rectoria) y por contagio entre unidades (bucle R2).
	|

churn de unidades=
	Unidades activas*fraccion de churn de unidades
	~	Unidad/Month
	~	Unidades que dejan de emitir aunque la institucion siga siendo cliente.
	|

unidades perdidas con instituciones=
	churn de instituciones*ZIDZ(Unidades activas,Instituciones cliente)
	~	Unidad/Month
	~	Unidades que se van cuando su institucion abandona.
	|

unidades iniciales=
	11
	~	Unidad [0,500,1]
	~	DATO HubSpot 17-oct-2026: una unidad por negocio Ganado credenciales POK.
	|

unidades academicas por institucion=
	8
	~	Unidad/Institucion [1,30,1]
	~	SUPUESTO: unidades potenciales por institucion (educacion continua, \
		innovacion, facultades, talento humano...).
	|

unidades de entrada por cliente=
	1
	~	Unidad/Institucion [1,5,1]
	~	Unidades con las que entra un cliente nuevo.
	|

fraccion de expansion institucional=
	0.004
	~	1/Month [0,0.05,0.001]
	~	SUPUESTO / PALANCA: expansion por decision central (vicerrectores, \
		rectores) por mes.
	|

efectividad del contagio interno=
	0.06
	~	1/Month [0,0.3,0.01]
	~	SUPUESTO: expansion por contagio entre unidades si toda la institucion ya \
		emitiera.
	|

fraccion de churn de unidades=
	0.01
	~	1/Month [0,0.05,0.001]
	~	SUPUESTO: churn mensual de unidades.
	|

********************************************************
	.docentes
********************************************************~
		Los docentes generan las evidencias de emision y tambien se certifican.
	|

Docentes activos= INTEG (
	incorporacion neta de docentes,
		unidades iniciales*docentes por unidad*fraccion base de docentes comprometidos)
	~	Docente [0,?]
	~	Docentes que generan evidencias en la plataforma.
	|

Docentes certificados= INTEG (
	certificacion de docentes-salida de docentes certificados,
		0)
	~	Docente [0,?]
	~	Docentes con credenciales propias de competencias (talento de la \
		universidad).
	|

incorporacion neta de docentes=
	(docentes comprometidos deseados-Docentes activos)/tiempo de adopcion docente
	~	Docente/Month
	~	Ajuste gradual hacia los docentes que deberian estar usando la plataforma.
	|

docentes comprometidos deseados=
	Unidades activas*docentes por unidad*fraccion de docentes comprometidos
	~	Docente
	~	
	|

fraccion de docentes comprometidos=
	MIN(fraccion maxima de docentes comprometidos,fraccion base de docentes comprometidos*(1+activar compromiso docente*efecto de la certificacion en el compromiso*fraccion de docentes certificados))
	~	Dmnl
	~	Los docentes que se certifican se vuelven promotores y comprometen a mas \
		colegas (bucle R4).
	|

fraccion de docentes certificados=
	ZIDZ(MIN(Docentes certificados,Docentes activos),Docentes activos)
	~	Dmnl
	~	
	|

certificacion de docentes=
	MAX(0,Docentes activos-Docentes certificados)*fraccion mensual de certificacion docente
	~	Docente/Month
	~	Docentes que certifican sus propias competencias.
	|

salida de docentes certificados=
	Docentes certificados/permanencia de docentes
	~	Docente/Month
	~	Rotacion de docentes certificados.
	|

capacidad de emision=
	Docentes activos*evidencias por docente
	~	Credencial/Month
	~	Credenciales que los docentes pueden respaldar con evidencias por mes \
		(bucle B4).
	|

docentes por unidad=
	30
	~	Docente/Unidad [5,200,5]
	~	SUPUESTO.
	|

fraccion base de docentes comprometidos=
	0.3
	~	Dmnl [0,1,0.05]
	~	SUPUESTO / PALANCA.
	|

fraccion maxima de docentes comprometidos=
	0.9
	~	Dmnl [0,1,0.05]
	~	SUPUESTO.
	|

efecto de la certificacion en el compromiso=
	1
	~	Dmnl [0,3,0.1]
	~	SUPUESTO: con todos los docentes certificados el compromiso se duplica (1 \
		= +100 %).
	|

tiempo de adopcion docente=
	6
	~	Month [1,24,1]
	~	SUPUESTO / PALANCA (capacitacion, onboarding).
	|

fraccion mensual de certificacion docente=
	0.02
	~	1/Month [0,0.2,0.005]
	~	SUPUESTO / PALANCA.
	|

permanencia de docentes=
	60
	~	Month [12,240,12]
	~	SUPUESTO.
	|

evidencias por docente=
	15
	~	Credencial/(Docente*Month) [1,100,1]
	~	SUPUESTO: credenciales por docente y mes que se pueden respaldar con \
		evidencias.
	|

********************************************************
	.estudiantes
********************************************************~
		Emision de credenciales y habito de los estudiantes.
	|

Credenciales emitidas= INTEG (
	emision de credenciales+credenciales docentes,
		credenciales iniciales)
	~	Credencial [0,?]
	~	Acumulado de credenciales emitidas.
	|

Titulares activos= INTEG (
	nuevos titulares-desactivacion de titulares,
		titulares iniciales)
	~	Persona [0,?]
	~	Estudiantes y egresados que usan o comparten activamente sus credenciales.
	|

demanda institucional de credenciales=
	Unidades activas*emision programada por unidad
	~	Credencial/Month
	~	Emisiones que las unidades planean (cursos, programas, eventos).
	|

demanda estudiantil de credenciales=
	activar habito estudiantil*Titulares activos*solicitudes por titular*Valor percibido de la credencial
	~	Credencial/Month
	~	Disparador del habito: necesito demostrar una competencia y pido la \
		credencial (bucle R3).
	|

demanda de credenciales=
	demanda institucional de credenciales+demanda estudiantil de credenciales
	~	Credencial/Month
	~	
	|

emision de credenciales=
	MIN(demanda de credenciales,capacidad de emision)
	~	Credencial/Month
	~	Lo que se emite: la demanda, salvo que falten docentes que generen \
		evidencias.
	|

credenciales docentes=
	certificacion de docentes*credenciales por docente certificado
	~	Credencial/Month
	~	
	|

nuevos titulares=
	emision de credenciales*fraccion de emisiones a nuevos titulares/credenciales por titular nuevo
	~	Persona/Month
	~	Personas que reciben su primera credencial.
	|

desactivacion de titulares=
	Titulares activos/tiempo de uso activo
	~	Persona/Month
	~	Titulares que dejan de usar sus credenciales.
	|

tiempo de uso activo=
	tiempo base de uso activo*(1+activar habito estudiantil*extension del uso por valor*Valor percibido de la credencial)
	~	Month
	~	Recompensa del habito: si la credencial sirve, se sigue usando por mas \
		tiempo.
	|

compartidas por titulares=
	Titulares activos*usos por titular
	~	Uso/Month
	~	Credenciales compartidas o presentadas (LinkedIn, wallets, postulaciones).
	|

credenciales iniciales=
	50000
	~	Credencial [0,1e+06,10000]
	~	SUPUESTO.
	|

titulares iniciales=
	20000
	~	Persona [0,500000,5000]
	~	SUPUESTO.
	|

emision programada por unidad=
	120
	~	Credencial/(Unidad*Month) [10,1000,10]
	~	SUPUESTO / PALANCA.
	|

solicitudes por titular=
	0.05
	~	Credencial/(Persona*Month) [0,0.5,0.01]
	~	SUPUESTO: credenciales adicionales que un titular pide por mes cuando la \
		credencial vale el maximo.
	|

fraccion de emisiones a nuevos titulares=
	0.5
	~	Dmnl [0,1,0.05]
	~	SUPUESTO: parte de las credenciales que va a personas sin credenciales \
		previas.
	|

credenciales por titular nuevo=
	1
	~	Credencial/Persona [1,5,1]
	~	
	|

credenciales por docente certificado=
	3
	~	Credencial/Docente [1,10,1]
	~	SUPUESTO.
	|

tiempo base de uso activo=
	18
	~	Month [3,60,1]
	~	SUPUESTO.
	|

extension del uso por valor=
	1
	~	Dmnl [0,3,0.1]
	~	SUPUESTO: con valor maximo el tiempo de uso activo se duplica.
	|

usos por titular=
	0.1
	~	Uso/(Persona*Month) [0,1,0.01]
	~	SUPUESTO.
	|

********************************************************
	.empresas
********************************************************~
		Sector productivo: busqueda de talento por credenciales y competencias.
	|

Empresas potenciales= INTEG (
	churn de empresas-adopcion de empresas,
		empresas en el mercado-empresas iniciales)
	~	Empresa [0,?]
	~	Empresas (talento humano) que aun no buscan talento por credenciales.
	|

Empresas usuarias= INTEG (
	adopcion de empresas-churn de empresas,
		empresas iniciales)
	~	Empresa [0,?]
	~	Empresas que buscan y verifican talento por credenciales.
	|

adopcion de empresas=
	Empresas potenciales*(fraccion de prospeccion de empresas+contagio empresarial+atraccion por talento)
	~	Empresa/Month
	~	
	|

contagio empresarial=
	activar boca a boca empresarial*efectividad del boca a boca empresarial*Empresas usuarias/empresas en el mercado
	~	1/Month
	~	Bucle R7.
	|

atraccion por talento=
	activar flywheel empresas*atraccion maxima por talento*probabilidad de encontrar talento
	~	1/Month
	~	Cuanto mas talento verificable hay, mas empresas buscan por credenciales \
		(bucle R5).
	|

probabilidad de encontrar talento=
	Titulares activos/(Titulares activos+talento de referencia)
	~	Dmnl
	~	Probabilidad de que una busqueda encuentre un candidato con la competencia \
		(saturante).
	|

churn de empresas=
	Empresas usuarias*fraccion de churn de empresas*(1-reduccion del churn por exito*probabilidad de encontrar talento)
	~	Empresa/Month
	~	Las empresas que no encuentran talento abandonan.
	|

busquedas de talento=
	Empresas usuarias*busquedas por empresa
	~	Busqueda/Month
	~	
	|

contrataciones por credencial=
	busquedas de talento*probabilidad de encontrar talento*contrataciones por busqueda exitosa
	~	Contratacion/Month
	~	
	|

verificaciones de empresas=
	busquedas de talento*verificaciones por busqueda
	~	Uso/Month
	~	Credenciales verificadas por reclutadores.
	|

dias de contratacion ahorrados=
	contrataciones por credencial*dias ahorrados por contratacion
	~	Dia/Month
	~	Recompensa para la empresa: menor tiempo de contratacion.
	|

empresas en el mercado=
	3000
	~	Empresa [100,50000,100]
	~	SUPUESTO.
	|

empresas iniciales=
	15
	~	Empresa [0,500,5]
	~	SUPUESTO.
	|

fraccion de prospeccion de empresas=
	0.001
	~	1/Month [0,0.02,0.0005]
	~	SUPUESTO / PALANCA.
	|

efectividad del boca a boca empresarial=
	0.05
	~	1/Month [0,0.3,0.01]
	~	SUPUESTO.
	|

atraccion maxima por talento=
	0.01
	~	1/Month [0,0.05,0.001]
	~	SUPUESTO.
	|

talento de referencia=
	200000
	~	Persona [10000,2e+06,10000]
	~	SUPUESTO: titulares activos con los que la mitad de las busquedas \
		encuentra candidato.
	|

fraccion de churn de empresas=
	0.03
	~	1/Month [0,0.1,0.005]
	~	SUPUESTO.
	|

reduccion del churn por exito=
	0.8
	~	Dmnl [0,1,0.05]
	~	SUPUESTO.
	|

busquedas por empresa=
	4
	~	Busqueda/(Empresa*Month) [0,50,1]
	~	SUPUESTO.
	|

contrataciones por busqueda exitosa=
	0.3
	~	Contratacion/Busqueda [0,1,0.05]
	~	SUPUESTO.
	|

verificaciones por busqueda=
	5
	~	Uso/Busqueda [0,50,1]
	~	SUPUESTO.
	|

dias ahorrados por contratacion=
	15
	~	Dia/Contratacion [0,60,1]
	~	SUPUESTO.
	|

********************************************************
	.ecosistema
********************************************************~
		Valor de la credencial como moneda de movilidad academica y laboral.
	|

uso de credenciales=
	compartidas por titulares+verificaciones de empresas
	~	Uso/Month
	~	Cuanto se usan las credenciales en el mercado.
	|

valor indicado de la credencial=
	1-EXP(-(peso del uso*uso de credenciales/uso de referencia+(1-peso del uso)*Empresas usuarias/empresas de referencia))
	~	Dmnl
	~	Valor de la credencial (0 a 1) segun su uso y cuantas empresas la \
		reconocen; satura en 1.
	|

Valor percibido de la credencial=
	SMOOTH3(valor indicado de la credencial,tiempo de percepcion del valor)
	~	Dmnl
	~	El mercado tarda en notar el valor (retraso de percepcion).
	|

uso de referencia=
	100000
	~	Uso/Month [10000,1e+06,10000]
	~	SUPUESTO: uso mensual con el que la credencial es moneda.
	|

empresas de referencia=
	300
	~	Empresa [50,5000,50]
	~	SUPUESTO: empresas que hacen de la credencial un estandar.
	|

peso del uso=
	0.5
	~	Dmnl [0,1,0.1]
	~	SUPUESTO.
	|

tiempo de percepcion del valor=
	12
	~	Month [1,36,1]
	~	SUPUESTO.
	|

********************************************************
	.interruptores
********************************************************~
		Apagar un bucle (0) muestra cuanto aporta al crecimiento.
	|

activar boca a boca institucional=
	1
	~	Dmnl [0,1,1]
	~	Bucle R1.
	|

activar expansion interna=
	1
	~	Dmnl [0,1,1]
	~	Bucle R2 (contagio entre unidades).
	|

activar habito estudiantil=
	1
	~	Dmnl [0,1,1]
	~	Bucle R3.
	|

activar compromiso docente=
	1
	~	Dmnl [0,1,1]
	~	Bucle R4.
	|

activar flywheel empresas=
	1
	~	Dmnl [0,1,1]
	~	Bucle R5.
	|

activar flywheel del ecosistema=
	1
	~	Dmnl [0,1,1]
	~	Bucle R6 (atraccion y retencion por valor).
	|

activar boca a boca empresarial=
	1
	~	Dmnl [0,1,1]
	~	Bucle R7.
	|

********************************************************
	.tactica paid media
********************************************************~
		Tactica de paid media (caballo de Troya): merahki abre una convocatoria para virtualizar gratis un curso corto de 10 horas. Todos los que se registran participan, uno por mes gana, y POK trabaja al resto de los leads.
	|

activar paid media=
	0
	~	Dmnl [0,1,1]
	~	INTERRUPTOR de la tactica: 1 la enciende (convocatoria de merahki dirigida \
		a instituciones que emiten con Certifie o Acredita: un curso corto \
		virtualizado gratis por mes). 0 = la base de HubSpot, sin la tactica.
	|

fraccion de potenciales con emisor competidor=
	0.3
	~	Dmnl [0,1,0.05]
	~	SUPUESTO: parte de las instituciones potenciales que ya emite con otro \
		proveedor. En las llamadas, unas 16 de 50 cuentas tenian emisor (caso de \
		uso UC1).
	|

instituciones con emisor competidor=
	Instituciones potenciales*fraccion de potenciales con emisor competidor
	~	Institucion
	~	Publico del anuncio. Se agota a medida que esas instituciones pasan a POK \
		(bucle B5).
	|

presupuesto base de paid media=
	1500
	~	USD/Month [0,10000,250]
	~	SUPUESTO / PALANCA: pauta mensual (LinkedIn, Meta, Google).
	|

costo por lead=
	60
	~	USD/Institucion [10,300,5]
	~	SUPUESTO: costo de que una institucion deje sus datos para pedir la \
		virtualizacion gratis.
	|

fraccion de leads calificados=
	0.4
	~	Dmnl [0,1,0.05]
	~	SUPUESTO: leads que de verdad emiten con Certifie o Acredita y pueden \
		decidir.
	|

alcance maximo mensual=
	0.1
	~	1/Month [0,0.5,0.01]
	~	SUPUESTO: parte de las instituciones con emisor competidor que la pauta \
		puede volver lead calificado en un mes, por mucho que se invierta.
	|

leads calificados de paid media=
	activar paid media*MIN(presupuesto de paid media/costo por lead*fraccion de leads calificados,instituciones con emisor competidor*alcance maximo mensual)
	~	Institucion/Month
	~	Instituciones que emiten con un competidor y se registran en la \
		convocatoria.
	|

cupos de virtualizacion gratis por mes=
	1
	~	Institucion/Month [0,10,1]
	~	DECISION / PALANCA: una virtualizacion gratis por mes entre todos los \
		registrados; el cupo unico es el mensaje de escasez.
	|

inicio de virtualizaciones gratis=
	MIN(leads calificados de paid media,cupos de virtualizacion gratis por mes)
	~	Institucion/Month
	~	Ganadoras de la convocatoria: reciben la virtualizacion gratis y el curso \
		se certifica con POK.
	|

Virtualizaciones gratis en curso= INTEG (
	inicio de virtualizaciones gratis-compras al terminar la virtualizacion-virtualizaciones que pasan al pipeline,
		0)
	~	Institucion [0,?]
	~	Instituciones con un curso en virtualizacion gratis por merahki.
	|

duracion de la virtualizacion=
	2
	~	Month [1,6,0.5]
	~	SUPUESTO: promesa de 8 semanas de merahki.
	|

fraccion que compra al terminar la virtualizacion=
	0.4
	~	Dmnl [0,1,0.05]
	~	SUPUESTO: instituciones ganadoras que compran POK al terminar, con el \
		curso ya certificado con POK. Algo mas que el 33 % de los pilotos, por \
		reciprocidad y porque ya vieron sus credenciales verificadas.
	|

compras al terminar la virtualizacion=
	Virtualizaciones gratis en curso/duracion de la virtualizacion*fraccion que compra al terminar la virtualizacion
	~	Institucion/Month
	~	Pasan directo a cliente.
	|

virtualizaciones que pasan al pipeline=
	Virtualizaciones gratis en curso/duracion de la virtualizacion*(1-fraccion que compra al terminar la virtualizacion)
	~	Institucion/Month
	~	No compran de inmediato y siguen en el pipeline de POK como pilotos.
	|

fraccion de leads sin cupo que llegan a propuesta=
	0.3
	~	Dmnl [0,1,0.05]
	~	SUPUESTO: registrados que no ganan el cupo y que JD o Francely llevan \
		hasta una propuesta de POK.
	|

propuestas de paid media sin cupo=
	(leads calificados de paid media-inicio de virtualizaciones gratis)*fraccion de leads sin cupo que llegan a propuesta
	~	Institucion/Month
	~	Registrados que no ganan el cupo y entran al pipeline de POK como pilotos.
	|

Propuestas de paid media en curso= INTEG (
	entrada de propuestas de paid media-salida de propuestas de paid media,
		0)
	~	Institucion [0,?]
	~	Seguimiento de los pilotos que vinieron de la tactica (ya estan contados \
		en Instituciones en piloto); sirve para atribuirle clientes y costo.
	|

entrada de propuestas de paid media=
	propuestas de paid media sin cupo+virtualizaciones que pasan al pipeline
	~	Institucion/Month
	~	
	|

salida de propuestas de paid media=
	Propuestas de paid media en curso/duracion del piloto
	~	Institucion/Month
	~	Se deciden al mismo ritmo que el resto del pipeline.
	|

clientes nuevos de paid media=
	compras al terminar la virtualizacion+salida de propuestas de paid media*fraccion de conversion de pilotos
	~	Institucion/Month
	~	
	|

Clientes ganados con paid media= INTEG (
	clientes nuevos de paid media,
		0)
	~	Institucion [0,?]
	~	Acumulado de clientes que trajo la tactica, sin descontar churn.
	|

ingreso anual por cliente nuevo=
	2000
	~	USD/Institucion [500,10000,250]
	~	SUPUESTO: ingreso del primer ano de un cliente POK nuevo. En HubSpot el \
		promedio sin Uniandes es de unos USD 1.960; el paquete tipico es NFT de \
		1.000 credenciales por USD 1.500.
	|

meses por ano=
	12
	~	Month
	~	
	|

ingreso mensual de clientes de paid media=
	Clientes ganados con paid media*ingreso anual por cliente nuevo/meses por ano
	~	USD/Month
	~	
	|

fraccion de ingresos reinvertida=
	0
	~	Dmnl [0,1,0.05]
	~	SUPUESTO: parte del ingreso de los clientes ganados que vuelve a la pauta \
		(bucle R8). 0 = presupuesto fijo.
	|

presupuesto de paid media=
	activar paid media*(presupuesto base de paid media+fraccion de ingresos reinvertida*ingreso mensual de clientes de paid media)
	~	USD/Month
	~	
	|

costo de una virtualizacion gratis=
	1500
	~	USD/Institucion [0,6000,250]
	~	SUPUESTO / PALANCA: costo para merahki de virtualizar un curso corto de 10 \
		horas (no el precio: merahki vendio un curso de 10 h a Uniandes en COP 12 \
		M, unos USD 3.700).
	|

gasto de la tactica=
	presupuesto de paid media+inicio de virtualizaciones gratis*costo de una virtualizacion gratis
	~	USD/Month
	~	Pauta mas virtualizaciones regaladas.
	|

Gasto acumulado de la tactica= INTEG (
	gasto de la tactica,
		0)
	~	USD [0,?]
	~	
	|

costo por cliente de paid media=
	ZIDZ(Gasto acumulado de la tactica,Clientes ganados con paid media)
	~	USD/Institucion
	~	CAC de la tactica.
	|

retorno anual por dolar invertido=
	ZIDZ(Clientes ganados con paid media*ingreso anual por cliente nuevo,Gasto acumulado de la tactica)
	~	Dmnl
	~	Ingreso del primer ano de los clientes ganados por cada dolar gastado. \
		Mayor que 1: la tactica se paga en el primer ano.
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 60
	~	Month
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Month
	~	The initial time for the simulation.
	|

SAVEPER  = 1
	~	Month [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.125
	~	Month [0,?]
	~	The time step for the simulation.
	|


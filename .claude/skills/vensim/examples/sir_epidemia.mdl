{UTF-8}
********************************************************
	.sir
********************************************************~
		Modelo SIR (Kermack-McKendrick) en formulacion de Sterman (2000), cap. 9.
	|

Susceptibles= INTEG (
	-tasa de infeccion,
		poblacion total-infecciosos iniciales)
	~	Person [0,?]
	~	Personas que pueden contagiarse.
	|

Infecciosos= INTEG (
	tasa de infeccion-tasa de recuperacion,
		infecciosos iniciales)
	~	Person [0,?]
	~	Personas que contagian.
	|

Recuperados= INTEG (
	tasa de recuperacion,
		0)
	~	Person [0,?]
	~	Personas inmunes (no hay muertes ni perdida de inmunidad en este modelo).
	|

tasa de infeccion=
	tasa de contactos*infectividad*Susceptibles*Infecciosos/poblacion total
	~	Person/Day
	~	Contactos de los susceptibles (S*c) por la probabilidad de que el contacto \
		sea con un infeccioso (I/N) por la probabilidad de contagio por contacto \
		(i).
	|

tasa de recuperacion=
	Infecciosos/duracion de la enfermedad
	~	Person/Day
	~	Salida de primer orden: duracion media de la infecciosidad d.
	|

tasa de contactos=
	5
	~	1/Day [0,20,0.5]
	~	Contactos por persona por dia (c).
	|

infectividad=
	0.1
	~	Dmnl [0,1,0.01]
	~	Probabilidad de contagio por contacto con un infeccioso (i).
	|

duracion de la enfermedad=
	5
	~	Day [1,20,0.5]
	~	Tiempo medio que una persona permanece infecciosa (d).
	|

poblacion total=
	10000
	~	Person
	~	Poblacion constante N = S + I + R.
	|

infecciosos iniciales=
	1
	~	Person
	~	Caso indice.
	|

numero reproductivo basico=
	tasa de contactos*infectividad*duracion de la enfermedad
	~	Dmnl
	~	R0 = c*i*d. Si R0 > 1 hay epidemia (umbral).
	|

numero reproductivo efectivo=
	numero reproductivo basico*Susceptibles/poblacion total
	~	Dmnl
	~	Re = R0*S/N. El pico de Infecciosos ocurre cuando Re cruza 1 (inmunidad de \
		rebaño).
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 120
	~	Day
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Day
	~	The initial time for the simulation.
	|

SAVEPER  =
        TIME STEP
	~	Day [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.0625
	~	Day [0,?]
	~	The time step for the simulation.
	|

\\\---/// Sketch information - do not modify anything except names
V300  Do not put anything below this section - it will be ignored

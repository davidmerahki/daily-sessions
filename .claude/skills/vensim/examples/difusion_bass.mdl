{UTF-8}
********************************************************
	.bass
********************************************************~
		Modelo de difusion de Bass (1969) en la formulacion de Sterman (2000), sec. 9.3.3.
	|

Adoptantes potenciales= INTEG (
	-tasa de adopcion,
		poblacion total-adoptantes iniciales)
	~	Person [0,?]
	~	Mercado aun no capturado.
	|

Adoptantes= INTEG (
	tasa de adopcion,
		adoptantes iniciales)
	~	Person [0,?]
	~	Clientes que ya adoptaron el producto.
	|

tasa de adopcion=
	adopcion por publicidad+adopcion por boca a boca
	~	Person/Year
	~	Flujo total de adopcion.
	|

adopcion por publicidad=
	efectividad de la publicidad*Adoptantes potenciales
	~	Person/Year
	~	Innovadores (coeficiente p de Bass). Arranca la difusion aun con \
		Adoptantes = 0.
	|

adopcion por boca a boca=
	tasa de contactos*fraccion de adopcion*Adoptantes potenciales*Adoptantes/poblacion total
	~	Person/Year
	~	Imitadores (coeficiente q = c*i de Bass).
	|

efectividad de la publicidad=
	0.011
	~	1/Year [0,0.1,0.001]
	~	Fraccion de adoptantes potenciales que adopta por publicidad cada año (p).
	|

tasa de contactos=
	100
	~	1/Year [0,200,5]
	~	Contactos por persona por año (c).
	|

fraccion de adopcion=
	0.015
	~	Dmnl [0,0.1,0.001]
	~	Probabilidad de adoptar por contacto con un adoptante (i).
	|

poblacion total=
	1e+06
	~	Person
	~	Tamaño del mercado N.
	|

adoptantes iniciales=
	0
	~	Person
	~	Sin adoptantes iniciales: la publicidad inicia el proceso.
	|

fraccion de mercado=
	Adoptantes/poblacion total
	~	Dmnl
	~	Penetracion de mercado.
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 15
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Year
	~	The initial time for the simulation.
	|

SAVEPER  =
        TIME STEP
	~	Year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.015625
	~	Year [0,?]
	~	The time step for the simulation.
	|


{UTF-8}
********************************************************
	.limites
********************************************************~
		Limites al crecimiento: un bucle R (natalidad) y dos bucles B (efectos de densidad) con lookups normalizados.
	|

Poblacion= INTEG (
	nacimientos-muertes,
		poblacion inicial)
	~	Animal [0,?]
	~	Poblacion de una especie en un habitat con capacidad de carga fija.
	|

nacimientos=
	Poblacion*fraccion normal de natalidad*efecto de la densidad sobre la natalidad(densidad percibida)
	~	Animal/Year
	~	Fraccion normal por multiplicador no lineal (formulacion 'efecto de X \
		sobre Y').
	|

muertes=
	Poblacion*fraccion normal de mortalidad*efecto de la densidad sobre la mortalidad(densidad percibida)
	~	Animal/Year
	~	Fraccion normal por multiplicador no lineal.
	|

fraccion normal de natalidad=
	0.05
	~	1/Year [0,0.2,0.005]
	~	Fraccion de natalidad cuando la densidad relativa es 1 (punto de \
		normalizacion).
	|

fraccion normal de mortalidad=
	0.05
	~	1/Year [0,0.2,0.005]
	~	Fraccion de mortalidad cuando la densidad relativa es 1. Igual a la de \
		natalidad: la capacidad de carga es el equilibrio.
	|

capacidad de carga=
	10000
	~	Animal [1000,20000,500]
	~	Poblacion que el habitat sostiene en equilibrio (valor de referencia X \
		normal).
	|

densidad relativa=
	Poblacion/capacidad de carga
	~	Dmnl
	~	Entrada normalizada X/X normal de los lookups.
	|

densidad percibida=
	SMOOTH3(densidad relativa, tiempo de percepcion de la densidad)
	~	Dmnl
	~	Retraso de informacion de tercer orden entre la densidad real y su efecto. \
		Con 1 año el comportamiento es casi logistico; con 10-20 años aparece \
		sobrepaso y oscilacion.
	|

tiempo de percepcion de la densidad=
	1
	~	Year [0.5,30,0.5]
	~	Retraso con que la densidad afecta natalidad y mortalidad.
	|

efecto de la densidad sobre la natalidad(
	[(0,0)-(2,2)],(0,2),(0.25,1.9),(0.5,1.7),(0.75,1.4),(1,1),(1.25,0.6),(1.5,0.35),(1.75,0.2),(2,0.1))
	~	Dmnl
	~	Normalizado: pasa por (1,1). Decreciente: el hacinamiento reduce la \
		natalidad. Pendiente suave en los extremos.
	|

efecto de la densidad sobre la mortalidad(
	[(0,0)-(2,2.8)],(0,0.5),(0.25,0.55),(0.5,0.65),(0.75,0.8),(1,1),(1.25,1.3),(1.5,1.7),(1.75,2.2),(2,2.8))
	~	Dmnl
	~	Normalizado: pasa por (1,1). Creciente: el hacinamiento aumenta la \
		mortalidad.
	|

poblacion inicial=
	100
	~	Animal
	~	Poblacion fundadora.
	|

fraccion neta de crecimiento=
	ZIDZ(nacimientos-muertes, Poblacion)
	~	1/Year
	~	Tasa neta por individuo; cae de 0.075 1/Year a 0 a medida que la poblacion \
		se acerca a la capacidad de carga.
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 200
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Year
	~	The initial time for the simulation.
	|

SAVEPER  =
        TIME STEP
	~	Year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.125
	~	Year [0,?]
	~	The time step for the simulation.
	|

\\\---/// Sketch information - do not modify anything except names
V300  Do not put anything below this section - it will be ignored

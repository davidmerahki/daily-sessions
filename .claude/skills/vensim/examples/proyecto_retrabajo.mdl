{UTF-8}
********************************************************
	.retrabajo
********************************************************~
		Ciclo de retrabajo (rework cycle) de un proyecto: el 'sindrome del 90 %'.
	|

Trabajo por hacer= INTEG (
	descubrimiento de retrabajo-trabajo correcto-trabajo defectuoso,
		alcance del proyecto)
	~	Task [0,?]
	~	Tareas pendientes (incluye el retrabajo ya descubierto).
	|

Trabajo correcto acumulado= INTEG (
	trabajo correcto,
		0)
	~	Task [0,?]
	~	Tareas terminadas sin errores.
	|

Retrabajo no descubierto= INTEG (
	trabajo defectuoso-descubrimiento de retrabajo,
		0)
	~	Task [0,?]
	~	Tareas que se creen terminadas pero tienen errores ocultos.
	|

tasa de trabajo=
	MIN(capacidad de trabajo, Trabajo por hacer/tiempo minimo por tarea)
	~	Task/Week
	~	MIN implementa el control de primer orden: Trabajo por hacer nunca se \
		vuelve negativo.
	|

capacidad de trabajo=
	personal*productividad
	~	Task/Week
	~	
	|

personal=
	20
	~	Person [1,40,1]
	~	
	|

productividad=
	1
	~	Task/(Person*Week) [0.2,3,0.1]
	~	
	|

tiempo minimo por tarea=
	1
	~	Week
	~	Duracion minima de una tarea (limita el flujo cuando queda poco trabajo).
	|

trabajo correcto=
	tasa de trabajo*calidad
	~	Task/Week
	~	
	|

trabajo defectuoso=
	tasa de trabajo*(1-calidad)
	~	Task/Week
	~	
	|

calidad=
	0.7
	~	Dmnl [0.3,1,0.05]
	~	Fraccion del trabajo realizado sin errores.
	|

descubrimiento de retrabajo=
	Retrabajo no descubierto/tiempo para descubrir retrabajo
	~	Task/Week
	~	Retraso material de primer orden: los errores se descubren en promedio \
		tras este tiempo.
	|

tiempo para descubrir retrabajo=
	20
	~	Week [1,40,1]
	~	Tiempo medio hasta detectar un error (pruebas tardias).
	|

alcance del proyecto=
	1000
	~	Task
	~	
	|

progreso percibido=
	(Trabajo correcto acumulado+Retrabajo no descubierto)/alcance del proyecto
	~	Dmnl
	~	Lo que el equipo cree terminado (incluye errores ocultos).
	|

progreso real=
	Trabajo correcto acumulado/alcance del proyecto
	~	Dmnl
	~	
	|

brecha de percepcion=
	progreso percibido-progreso real
	~	Dmnl
	~	Igual a Retrabajo no descubierto / alcance.
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 200
	~	Week
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Week
	~	The initial time for the simulation.
	|

SAVEPER  =
        TIME STEP
	~	Week [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.125
	~	Week [0,?]
	~	The time step for the simulation.
	|

\\\---/// Sketch information - do not modify anything except names
V300  Do not put anything below this section - it will be ignored

{UTF-8}
********************************************************
	.cadena
********************************************************~
		Cadena de envejecimiento (aging chain) de tres cohortes, subindicada por region.
	|

Region:
	norte, sur
	~	
	~	Rango de subindices: dos regiones con parametros distintos.
	|

Menores[Region]= INTEG (
	nacimientos[Region]-maduracion[Region]-muertes de menores[Region],
		menores iniciales[Region])
	~	Person [0,?]
	~	Cohorte 0-15 años.
	|

Adultos[Region]= INTEG (
	maduracion[Region]+migracion neta[Region]-envejecimiento[Region]-muertes de adultos[Region],
		adultos iniciales[Region])
	~	Person [0,?]
	~	Cohorte 15-65 años.
	|

Mayores[Region]= INTEG (
	envejecimiento[Region]-muertes de mayores[Region],
		mayores iniciales[Region])
	~	Person [0,?]
	~	Cohorte de 65 años y más.
	|

nacimientos[Region]=
	Adultos[Region]*fecundidad[Region]
	~	Person/Year
	~	Bucle R: más adultos -> más nacimientos -> más menores -> más adultos (con \
		retraso de 15 años).
	|

maduracion[Region]=
	Menores[Region]/duracion de la infancia
	~	Person/Year
	~	Salida de primer orden: tiempo medio de residencia en la cohorte.
	|

envejecimiento[Region]=
	Adultos[Region]/duracion de la adultez
	~	Person/Year
	~	Salida de primer orden hacia la cohorte de mayores.
	|

muertes de menores[Region]=
	Menores[Region]*mortalidad infantil[Region]
	~	Person/Year
	~	
	|

muertes de adultos[Region]=
	Adultos[Region]*mortalidad adulta
	~	Person/Year
	~	mortalidad adulta no tiene subindice: el mismo valor se aplica a todas las \
		regiones.
	|

muertes de mayores[Region]=
	Mayores[Region]/esperanza de vida de los mayores[Region]
	~	Person/Year
	~	
	|

migracion neta[norte]=
	-flujo migratorio ~~|
migracion neta[sur]=
	flujo migratorio
	~	Person/Year
	~	Ecuaciones por elemento: lo que sale del norte entra al sur (se conserva la poblacion).
	|

flujo migratorio=
	Adultos[norte]*fraccion de migracion
	~	Person/Year
	~	Adultos que migran de norte a sur cada año.
	|

fraccion de migracion=
	0.004
	~	1/Year [0,0.05,0.001]
	~	
	|

fecundidad[Region]=
	0.04, 0.025
	~	1/Year
	~	Nacimientos por adulto por año (norte, sur).
	|

mortalidad infantil[Region]=
	0.004, 0.002
	~	1/Year
	~	
	|

mortalidad adulta=
	0.003
	~	1/Year
	~	
	|

esperanza de vida de los mayores[Region]=
	12, 16
	~	Year
	~	Permanencia media en la cohorte de mayores.
	|

duracion de la infancia=
	15
	~	Year
	~	
	|

duracion de la adultez=
	50
	~	Year
	~	
	|

menores iniciales[Region]=
	300000, 150000
	~	Person
	~	
	|

adultos iniciales[Region]=
	600000, 500000
	~	Person
	~	
	|

mayores iniciales[Region]=
	80000, 120000
	~	Person
	~	
	|

poblacion total[Region]=
	Menores[Region]+Adultos[Region]+Mayores[Region]
	~	Person
	~	
	|

poblacion total global=
	SUM(poblacion total[Region!])
	~	Person
	~	Suma sobre el rango Region (operador !).
	|

fraccion de mayores[Region]=
	ZIDZ(Mayores[Region], poblacion total[Region])
	~	Dmnl
	~	
	|

razon de dependencia[Region]=
	ZIDZ(Menores[Region]+Mayores[Region], Adultos[Region])
	~	Dmnl
	~	Dependientes por adulto en edad de trabajar.
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 100
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Year
	~	The initial time for the simulation.
	|

SAVEPER  =
        TIME STEP
	~	Year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.25
	~	Year [0,?]
	~	The time step for the simulation.
	|

\\\---/// Sketch information - do not modify anything except names
V300  Do not put anything below this section - it will be ignored

{UTF-8}
********************************************************
	.demanda
********************************************************~
		Demanda exogena con escalon y pronostico por suavizado exponencial.
	|

pedidos de clientes=
	demanda base*(1+STEP(incremento de la demanda, tiempo del escalon))
	~	Widget/Week
	~	Demanda exogena: escalon de +20 % en la semana 10 (prueba clasica de \
		respuesta).
	|

demanda base=
	100
	~	Widget/Week
	~	Demanda inicial (equilibrio).
	|

incremento de la demanda=
	0.2
	~	Dmnl [-0.5,1,0.05]
	~	Altura relativa del escalon.
	|

tiempo del escalon=
	10
	~	Week
	~	Momento del escalon.
	|

pedidos esperados=
	SMOOTH(pedidos de clientes, tiempo para promediar pedidos)
	~	Widget/Week
	~	Pronostico de demanda por suavizado exponencial de primer orden (retraso \
		de informacion).
	|

tiempo para promediar pedidos=
	4
	~	Week [1,20,1]
	~	Constante de tiempo del pronostico.
	|

********************************************************
	.inventario
********************************************************~
		Cadena de stock de producto terminado.
	|

Inventario= INTEG (
	produccion-envios,
		inventario deseado)
	~	Widget [0,?]
	~	Producto terminado. Arranca en su valor deseado (equilibrio).
	|

envios=
	MIN(pedidos de clientes, envios maximos)
	~	Widget/Week
	~	No se puede enviar más de lo que el inventario permite (control de primer \
		orden: el stock no puede ser negativo).
	|

envios maximos=
	Inventario/tiempo minimo de procesamiento
	~	Widget/Week
	~	Capacidad de envio limitada por el inventario disponible.
	|

tiempo minimo de procesamiento=
	1
	~	Week
	~	Tiempo minimo para preparar un envio.
	|

inventario deseado=
	pedidos esperados*cobertura deseada de inventario
	~	Widget
	~	Objetivo del bucle de ajuste de inventario.
	|

cobertura deseada de inventario=
	4
	~	Week
	~	Semanas de demanda esperada que se quiere tener en stock.
	|

ajuste de inventario=
	(inventario deseado-Inventario)/tiempo de ajuste de inventario
	~	Widget/Week
	~	Formulacion canonica de ajuste de stock (stock adjustment): brecha / \
		tiempo de ajuste.
	|

tiempo de ajuste de inventario=
	8
	~	Week [1,20,1]
	~	Rapidez con que se corrige la brecha de inventario.
	|

produccion deseada=
	MAX(0, pedidos esperados+ajuste de inventario)
	~	Widget/Week
	~	Reponer lo que se espera vender más la correccion de inventario; no \
		negativa.
	|

********************************************************
	.fuerza laboral
********************************************************~
		Ajuste de la fuerza laboral con retraso de contratacion.
	|

fuerza laboral deseada=
	produccion deseada/productividad
	~	Person
	~	Personal necesario para la produccion deseada.
	|

productividad=
	1
	~	Widget/(Person*Week)
	~	Widgets por persona por semana.
	|

Fuerza laboral= INTEG (
	contratacion neta,
		fuerza laboral deseada)
	~	Person [0,?]
	~	Trabajadores empleados. Arranca en equilibrio.
	|

contratacion neta deseada=
	(fuerza laboral deseada-Fuerza laboral)/tiempo de ajuste de la fuerza laboral
	~	Person/Week
	~	Brecha de personal / tiempo de ajuste (positiva = contratar, negativa = \
		despedir).
	|

tiempo de ajuste de la fuerza laboral=
	4
	~	Week [1,20,1]
	~	Rapidez deseada de correccion de personal.
	|

contratacion neta=
	DELAY3(contratacion neta deseada, retraso de contratacion)
	~	Person/Week
	~	Las decisiones de contratacion se materializan con un retraso de tercer \
		orden (vacantes, seleccion, preaviso).
	|

retraso de contratacion=
	3
	~	Week [1,20,1]
	~	Retraso medio entre decidir y contratar/despedir.
	|

produccion=
	Fuerza laboral*productividad
	~	Widget/Week
	~	Produccion efectiva.
	|

cobertura de inventario=
	ZIDZ(Inventario, envios)
	~	Week
	~	Semanas de envios que cubre el inventario actual (ZIDZ evita dividir por \
		cero).
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 100
	~	Week
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Week
	~	The initial time for the simulation.
	|

SAVEPER  =
        TIME STEP
	~	Week [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.0625
	~	Week [0,?]
	~	The time step for the simulation.
	|


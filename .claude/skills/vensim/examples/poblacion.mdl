{UTF-8}
********************************************************
	.poblacion
********************************************************~
		Crecimiento poblacional con un bucle R (nacimientos) y un bucle B (muertes).
	|

Poblacion= INTEG (
	nacimientos-muertes,
		poblacion inicial)
	~	Person [0,?]
	~	Stock (nivel) de personas. Acumula nacimientos menos muertes.
	|

nacimientos=
	Poblacion*tasa de natalidad
	~	Person/Year
	~	Flujo de entrada. Bucle R1: más poblacion -> más nacimientos -> más \
		poblacion.
	|

muertes=
	Poblacion/esperanza de vida
	~	Person/Year
	~	Flujo de salida (vaciado de primer orden). Bucle B1: más poblacion -> más \
		muertes -> menos poblacion.
	|

tasa de natalidad=
	0.03
	~	1/Year [0,0.1,0.005]
	~	Nacimientos por persona por año (fraccion de natalidad).
	|

esperanza de vida=
	50
	~	Year [10,100,1]
	~	Tiempo medio de permanencia en el stock; la fraccion de mortalidad es \
		1/esperanza de vida = 0.02 1/Year.
	|

poblacion inicial=
	1000
	~	Person
	~	Valor inicial del stock Poblacion.
	|

fraccion neta de crecimiento=
	tasa de natalidad-1/esperanza de vida
	~	1/Year
	~	Ganancia neta del sistema: >0 crecimiento exponencial, <0 decaimiento, =0 \
		equilibrio.
	|

tiempo de duplicacion=
	XIDZ(LN(2), fraccion neta de crecimiento, -1)
	~	Year
	~	Tiempo de duplicacion exacto ln(2)/g (aprox. 70/g en %, la regla del 70). \
		Devuelve -1 (bandera) si la fraccion neta es cero; solo tiene sentido si \
		g>0.
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 100
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Year
	~	The initial time for the simulation.
	|

SAVEPER  =
        TIME STEP
	~	Year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.125
	~	Year [0,?]
	~	The time step for the simulation.
	|

\\\---/// Sketch information - do not modify anything except names
V300  Do not put anything below this section - it will be ignored
